rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    function incomingDocOwner() {
      return isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    function isNonEmptyString(val, maxLength) {
      return val is string && val.size() > 0 && val.size() <= maxLength;
    }

    // -------------------------------------------------------------
    // User Profiles
    // Users can ONLY read and write their own profile.
    // -------------------------------------------------------------
    match /profiles/{userId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.id == userId
        && isNonEmptyString(request.resource.data.full_name, 100)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 500)
        && (!('address' in request.resource.data) || request.resource.data.address.size() <= 300)
        && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 30);

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Service Providers (Master Catalog)
    // Public directory is readable.
    // Providers can only update their own availability and status, NOT their rating.
    // -------------------------------------------------------------
    match /service_providers/{providerId} {
      allow read: if true;

      allow update: if isOwner(providerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'availability_slots',
             'next_slot',
             'status',
             'is_online',
             'updated_at',
             'phone',
             'whatsapp'
           ])
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.reliability == resource.data.reliability
        && request.resource.data.id == resource.data.id;

      allow create, delete: if false;
    }

    // -------------------------------------------------------------
    // Bookings
    // Customers can only read and write their own bookings.
    // Assigned providers can view their bookings and update fulfillment status.
    // -------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.provider_id == request.auth.uid
      );

      allow create: if incomingDocOwner()
        && isNonEmptyString(request.resource.data.provider_id, 100)
        && request.resource.data.quote_total is int
        && request.resource.data.quote_total > 0
        && request.resource.data.quote_base is int
        && request.resource.data.quote_base > 0
        && request.resource.data.status in ['scheduled', 'en_route']
        && request.resource.data.created_at != null;

      allow update: if isAuthenticated() && (
        (isDocOwner()
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.provider_id == resource.data.provider_id
          && request.resource.data.quote_total == resource.data.quote_total
          && request.resource.data.quote_base == resource.data.quote_base
          && request.resource.data.status in ['scheduled', 'en_route', 'cancelled', 'issue_reported'])
        ||
        (resource.data.provider_id == request.auth.uid
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.provider_id == resource.data.provider_id
          && request.resource.data.quote_total == resource.data.quote_total
          && request.resource.data.quote_base == resource.data.quote_base
          && request.resource.data.status in ['en_route', 'in_progress', 'completed', 'cancelled'])
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Reviews
    // Reviews can ONLY be created by the customer associated with a COMPLETED booking.
    // -------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;

      function hasCompletedBooking(bookingId) {
        return exists(/databases/$(database)/documents/bookings/$(bookingId))
          && get(/databases/$(database)/documents/bookings/$(bookingId)).data.user_id == request.auth.uid
          && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'completed'
          && get(/databases/$(database)/documents/bookings/$(bookingId)).data.provider_id == request.resource.data.provider_id;
      }

      allow create: if incomingDocOwner()
        && isNonEmptyString(request.resource.data.provider_id, 100)
        && isNonEmptyString(request.resource.data.booking_id, 100)
        && hasCompletedBooking(request.resource.data.booking_id)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.created_at != null;

      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // Agent Workflow Events (Audit Trail)
    // -------------------------------------------------------------
    match /agent_events/{eventId} {
      allow read: if isDocOwner();
      allow create: if incomingDocOwner()
        && isNonEmptyString(request.resource.data.booking_id, 100);
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // Default Fallback: Deny Everything Else
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
